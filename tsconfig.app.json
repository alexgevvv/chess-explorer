{
  "compilerOptions": {
    "target": "es2023",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "tsBuildInfoFile": "./node_modules/.tmp/app.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src"
  ]
}
