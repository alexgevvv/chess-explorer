{
  "compilerOptions": {
    "target": "es2023",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "tsBuildInfoFile": "./node_modules/.tmp/node.tsbuildinfo",
    "module": "nodenext",
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts"
  ]
}
